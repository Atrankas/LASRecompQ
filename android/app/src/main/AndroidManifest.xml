<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:name="android.hardware.vulkan.version" android:version="0x401000" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />

    <!-- The app never goes online: no network permissions, even if a library asked for one. -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />
    <!-- rumble on this device while playing by touch -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- controllers over Bluetooth / USB (SDL's HIDAPI drivers) -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- building the game code on the phone (BuildService): keeps running with the screen off, shows its progress -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- the game kept alive (paused) while another app is in front: PlayService -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- allowNativeHeapPointerTagging: off - the runtime keeps host pointers in 64-bit values the guest also handles,
         and Android 11+ puts a tag in the top byte of malloc'd pointers otherwise -->
    <application
        android:allowBackup="false"
        android:appCategory="game"
        android:hasFragileUserData="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:isGame="true"
        android:label="@string/app_name"
        android:allowNativeHeapPointerTagging="false"
        android:extractNativeLibs="${extractNativeLibs}"
        android:theme="@style/AppTheme">
        <meta-data android:name="android.game_mode_config" android:resource="@xml/game_mode_config" />
        <!-- lets Android's CPU profiler (simpleperf) attach to release builds over adb; no other effect -->
        <profileable android:shell="true" />
        <activity
            android:name=".LasActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:supportsPictureInPicture="false"
            android:preferMinimalPostProcessing="true"
            android:screenOrientation="sensorLandscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="com.oculus.intent.category.VR" />
            </intent-filter>
        </activity>
        <!-- keeps the app alive while the game code is built on the phone (runtime/gamebuild.c). extractNativeLibs
             above: true in the builds that do that (build.gradle onDeviceBuild) - their programs (python, zig: lib*.so)
             must exist as files in the native library folder to run -->
        <service
            android:name=".BuildService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <!-- keeps the process alive while the game is open, so a trip to the home screen doesn't end it (PlayService) -->
        <service
            android:name=".PlayService"
            android:exported="false"
            android:stopWithTask="true"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps a paused game session in memory while the player is in another app" />
        </service>
    </application>
</manifest>
